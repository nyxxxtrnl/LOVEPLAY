rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && get(/databases/$(database)/documents/conversations/$(conversationId))
          .data.participants.hasAny([request.auth.uid]);
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName', 'displayNameSearch', 'createdAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'displayNameSearch', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.displayNameSearch is string
        && request.resource.data.displayNameSearch.size() >= 2
        && request.resource.data.displayNameSearch.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName', 'displayNameSearch', 'createdAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'displayNameSearch', 'createdAt', 'photoUrl'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.displayNameSearch is string
        && request.resource.data.displayNameSearch.size() >= 2
        && request.resource.data.displayNameSearch.size() <= 40
        && (
          !request.resource.data.keys().hasAny(['photoUrl'])
          || (
            request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() <= 180000
          )
        );
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || resource.data.participants.hasAny([request.auth.uid])
        );
      allow list: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['participants', 'createdAt', 'updatedAt', 'lastMessage'])
        && request.resource.data.keys().hasOnly(['participants', 'createdAt', 'updatedAt', 'lastMessage'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && conversationId == 'dm_' + request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.participants[0]))
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.participants[1]))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage == '';
      allow update: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessage'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
