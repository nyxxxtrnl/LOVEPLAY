rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && get(/databases/$(database)/documents/conversations/$(conversationId))
          .data.participants.hasAny([request.auth.uid]);
    }

    function isMessageAllowedByBlock(conversationId) {
      let conversation = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      let blockedBy = conversation.get('blockedBy', []);
      return (
        conversation.participants[0] == request.auth.uid
        && !blockedBy.hasAny([conversation.participants[1]])
      ) || (
        conversation.participants[1] == request.auth.uid
        && !blockedBy.hasAny([conversation.participants[0]])
      );
    }

    function isAllowedMessageReaction(reaction) {
      return reaction in ['❤️', '😂', '👍', '😮', '😢', '👏'];
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName', 'displayNameSearch', 'createdAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'displayNameSearch', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.displayNameSearch is string
        && request.resource.data.displayNameSearch.size() >= 2
        && request.resource.data.displayNameSearch.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName', 'displayNameSearch', 'createdAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'displayNameSearch', 'createdAt', 'photoUrl'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.displayNameSearch is string
        && request.resource.data.displayNameSearch.size() >= 2
        && request.resource.data.displayNameSearch.size() <= 40
        && (
          !request.resource.data.keys().hasAny(['photoUrl'])
          || (
            request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() <= 180000
          )
        );
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      function validSelfMembershipChange(fieldName) {
        let oldMembers = resource.data.get(fieldName, []);
        let newMembers = request.resource.data.get(fieldName, []);
        return oldMembers is list
          && newMembers is list
          && newMembers.size() <= 2
          && newMembers.hasOnly(resource.data.participants)
          && newMembers.hasAny([request.auth.uid]) != oldMembers.hasAny([request.auth.uid])
          && (
            (
              resource.data.participants[0] == request.auth.uid
              && newMembers.hasAny([resource.data.participants[1]])
                == oldMembers.hasAny([resource.data.participants[1]])
            )
            || (
              resource.data.participants[1] == request.auth.uid
              && newMembers.hasAny([resource.data.participants[0]])
                == oldMembers.hasAny([resource.data.participants[0]])
            )
          );
      }

      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || resource.data.participants.hasAny([request.auth.uid])
        );
      allow list: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['participants', 'createdAt', 'updatedAt', 'lastMessage'])
        && request.resource.data.keys().hasOnly(['participants', 'createdAt', 'updatedAt', 'lastMessage'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && conversationId == 'dm_' + request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.participants[0]))
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.participants[1]))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage == '';
      allow update: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid])
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'lastMessage'])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 2000
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedBy'])
            && validSelfMembershipChange('blockedBy')
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
            && validSelfMembershipChange('hiddenFor')
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId)
          && isMessageAllowedByBlock(conversationId)
          && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'type', 'reactions', 'createdAt'])
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'text', 'type', 'reactions', 'createdAt', 'mediaUrl', 'mediaPath'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.type in ['text', 'image', 'audio', 'gif', 'sticker']
          && request.resource.data.reactions is map
          && request.resource.data.reactions.size() == 0
          && request.resource.data.createdAt == request.time
          && (
            (
              request.resource.data.type == 'text'
              && request.resource.data.text.size() > 0
              && !request.resource.data.keys().hasAny(['mediaUrl', 'mediaPath'])
            )
            || (
              request.resource.data.type == 'sticker'
              && request.resource.data.text in ['❤️', '🥰', '😘', '😂', '🥹', '🐻', '🌷', '✨']
              && !request.resource.data.keys().hasAny(['mediaUrl', 'mediaPath'])
            )
            || (
              request.resource.data.type == 'gif'
              && request.resource.data.text == 'GIF'
              && request.resource.data.keys().hasAll(['mediaUrl'])
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() <= 2000
              && (
                request.resource.data.mediaUrl.matches('^https://media\\.giphy\\.com/.+\\.gif$')
                || request.resource.data.mediaUrl.matches('^https://i\\.giphy\\.com/.+\\.gif$')
                || request.resource.data.mediaUrl.matches('^https://media\\.tenor\\.com/.+\\.gif$')
              )
              && !request.resource.data.keys().hasAny(['mediaPath'])
            )
            || (
              request.resource.data.type == 'image'
              && request.resource.data.text == 'Photo'
              && request.resource.data.keys().hasAll(['mediaUrl', 'mediaPath'])
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.matches('^https://firebasestorage\\.googleapis\\.com/.+$')
              && request.resource.data.mediaPath is string
              && request.resource.data.mediaPath.matches(
                '^conversations/' + conversationId + '/messages/' + request.auth.uid + '/[^/]+$'
              )
            )
            || (
              request.resource.data.type == 'image'
              && request.resource.data.text == 'Photo'
              && request.resource.data.keys().hasAll(['mediaUrl'])
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() <= 900000
              && request.resource.data.mediaUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$')
              && !request.resource.data.keys().hasAny(['mediaPath'])
            )
            || (
              request.resource.data.type == 'audio'
              && request.resource.data.text == 'Voice message'
              && request.resource.data.keys().hasAll(['mediaUrl', 'mediaPath'])
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.matches('^https://firebasestorage\\.googleapis\\.com/.+$')
              && request.resource.data.mediaPath is string
              && request.resource.data.mediaPath.matches(
                '^conversations/' + conversationId + '/messages/' + request.auth.uid + '/[^/]+$'
              )
            )
          );
        allow update: if isConversationParticipant(conversationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.diff(resource.data.get('reactions', {}))
            .affectedKeys().hasOnly([request.auth.uid])
          && (
            !request.resource.data.reactions.keys().hasAny([request.auth.uid])
            || isAllowedMessageReaction(request.resource.data.reactions[request.auth.uid])
          );
        allow delete: if isConversationParticipant(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
